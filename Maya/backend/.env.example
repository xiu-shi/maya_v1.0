# AI Builders MCP Server Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control

# Required: Your AI Builders API token
AI_BUILDER_TOKEN=sk_your_token_here

# Server Configuration
NODE_ENV=development
PORT=3000

# CORS Configuration (comma-separated list of allowed origins)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:8080,https://agents.janetxiushi.me,https://janetxiushi.me

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=20

# Request Size Limits
MAX_REQUEST_SIZE=1mb
MAX_MESSAGE_LENGTH=2000
MAX_HISTORY_LENGTH=50

# Security
ENABLE_HTTPS_REDIRECT=false
TRUST_PROXY=false

# Admin Authentication
# Required to access /api/admin/* endpoints and /api/kb/status.
# Generate a strong random token, e.g.: openssl rand -hex 32
# Set this in your deployment platform environment variables.
ADMIN_TOKEN=your_strong_random_token_here

# AI Builders API Configuration (optional - defaults provided)
AI_BUILDERS_API_URL=https://api.aibuilders.co/v1/chat/completions
AI_BUILDERS_MODEL=gpt-4

# Maya System Instructions (Development)
# Path to system instruction file (relative to Maya/backend/)
# In production, use SYSTEM_INSTRUCTION environment variable instead
SYSTEM_INSTRUCTION_FILE=./system_prompt.txt

# Maya System Instructions (Production - AI Builders Platform)
# Set this environment variable in your deployment platform with the full system instructions
# This takes precedence over SYSTEM_INSTRUCTION_FILE
# SYSTEM_INSTRUCTION="[paste full system instruction content here]"

# AWS S3 chat logging (optional)
# ENABLE_S3_LOGGING=false
# AWS_REGION=eu-west-1
# AWS_S3_BUCKET=your-bucket-name
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Required when ENABLE_S3_LOGGING=true. HMAC secret for IP pseudonymisation in S3 object keys.
# Generate e.g.: openssl rand -hex 32
# IP_HASH_SECRET=your_random_hmac_secret_here
